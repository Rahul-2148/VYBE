# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION - CLIENT
# ============================================

# Environment
VITE_NODE_ENV=production

# Server URLs
VITE_SERVER_URL=https://api.vybe.com
VITE_CLIENT_URL=https://vybe.com

# Socket.IO Configuration
VITE_SOCKET_URL=https://api.vybe.com
VITE_SOCKET_PATH=/socket.io
VITE_SOCKET_TRANSPORTS=websocket

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-production-google-client-id

# API Configuration
VITE_API_TIMEOUT=30000
VITE_REQUEST_RETRY_ATTEMPTS=3

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_LOGGING=false
