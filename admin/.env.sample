# ==============================================================================
# 🚀 VYBE ADMIN PANEL - COMPLETE ENVIRONMENT TEMPLATE (.env.sample)
# ==============================================================================
# Duplicate this file as '.env' (for local development) or configure in your deployment dashboard (Vercel/Netlify).

# 1. Backend REST API Base URL
# Local: http://localhost:8000/api/v1/admin
# Production: https://your-backend-api.onrender.com/api/v1/admin
VITE_API_URL="http://localhost:8000/api/v1/admin"

# 2. WebSocket Telemetry Server URL
# Local: http://localhost:8000
# Production: https://your-backend-api.onrender.com
VITE_SOCKET_URL="http://localhost:8000"

# 3. Main User Web App URL (for Sidebar Quick Switch)
# Local: http://localhost:5173
# Production: https://your-client-app.vercel.app
VITE_USER_APP_URL="http://localhost:5173"

# 4. Google Workspace SSO Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID="806066087982-6mp4ree3r9jnm2o8dsfdm3neoavg789r.apps.googleusercontent.com"
