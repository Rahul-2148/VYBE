# ==============================================================================
# 🚀 VYBE BACKEND SERVER - COMPLETE ENVIRONMENT CONFIGURATION TEMPLATE (.env.sample)
# ==============================================================================
# Copy this file to '.env' (for development) and '.env.production' (for production)

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORK
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
HOST=localhost

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas / Local MongoDB)
# ------------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/vybe?retryWrites=true&w=majority"
# MONGO_URI="mongodb://127.0.0.1:27017/vybe"

# ------------------------------------------------------------------------------
# 3. JWT & SESSION AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET="generate-a-strong-random-64-character-jwt-secret-key-for-vybe-auth"
REFRESH_TOKEN_SECRET="generate-a-strong-random-64-character-refresh-secret-key-for-vybe"

# ------------------------------------------------------------------------------
# 4. REDIS & SOCKET.IO HORIZONTAL SCALING (Optional with Auto-Fallback)
# ------------------------------------------------------------------------------
# Leave empty for Single-Server / Local Dev (Uses High-Speed In-Memory Fallback)
# Set for Clustered / Multi-Server Production (Upstash, AWS ElastiCache, Redis Cloud)
# REDIS_URL="redis://default:password@your-redis-host.upstash.io:6379"

# Socket.IO Gateway Configuration
SOCKET_HOST="http://localhost:8000"
SOCKET_TRANSPORTS="websocket,polling"
SOCKET_CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT & CORS ORIGINS
# ------------------------------------------------------------------------------
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 6. EMAIL & SMTP SERVICE (For Registration OTP & Password Reset)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_EMAIL="your-official-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"

# ------------------------------------------------------------------------------
# 7. HTTP COOKIE SECURITY POLICIES
# ------------------------------------------------------------------------------
# Set COOKIE_SECURE=true for HTTPS in production, false for local HTTP dev
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
COOKIE_HTTP_ONLY=true
COOKIE_DOMAIN=""
COOKIE_MAX_AGE=7776000000

# ------------------------------------------------------------------------------
# 8. CLOUDINARY MEDIA CLOUD STORAGE (Images, Reels, Videos & Stories)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="vybe-uploads"

# ------------------------------------------------------------------------------
# 9. GOOGLE OAUTH 2.0 SINGLE SIGN-ON (SSO)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CLIENT_IDS=""

# ------------------------------------------------------------------------------
# 10. RAZORPAY MONETIZATION & CREATOR SUBSCRIPTIONS
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_S1Vs1ViGRVLSlE"
RAZORPAY_KEY_SECRET="A2yFN4pvGLbVGdL6aOXLF4mX"

# ------------------------------------------------------------------------------
# 11. WEBRTC AUDIO/VIDEO CALLING & LIVE STREAMING (STUN/TURN)
# ------------------------------------------------------------------------------
TURN_SECRET="vybe_coturn_secret_pass_2026"
TURN_SERVER_DOMAIN="turn.vybe.app"
STUN_SERVER_URL="stun:stun.l.google.com:19302"

# ------------------------------------------------------------------------------
# 12. ARTIFICIAL INTELLIGENCE (VYBE AI Studio, Captions & Moderation)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# ------------------------------------------------------------------------------
# 13. FILE UPLOADS & SERVER LIMITS
# ------------------------------------------------------------------------------
MAX_FILE_SIZE=1073741824
UPLOAD_DIR="./uploads"

# ------------------------------------------------------------------------------
# 14. LOGGING & SYSTEM TELEMETRY
# ------------------------------------------------------------------------------
LOG_LEVEL="debug"
