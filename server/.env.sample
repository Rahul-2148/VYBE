# ==============================================================================
# 🚀 VYBE BACKEND SERVER - COMPLETE ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' (for local development) or configure in your production host (Render/Railway/VPS).

# 1. APPLICATION ENVIRONMENT & NETWORK
NODE_ENV=development
PORT=8000
HOST=localhost

# 2. DATABASE CONFIGURATION (MongoDB Atlas / Local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/VYBE?retryWrites=true&w=majority"

# 3. JWT & SESSION AUTHENTICATION SECRETS
JWT_SECRET="your-strong-random-64-character-jwt-secret-key-here"
REFRESH_TOKEN_SECRET="your-strong-random-64-character-refresh-secret-key-here"

# 4. REDIS & SOCKET.IO HORIZONTAL SCALING (Optional with Auto-Fallback)
# REDIS_URL="redis://default:password@your-redis-host:6379"
SOCKET_HOST="http://localhost:8000"
SOCKET_TRANSPORTS="websocket,polling"
SOCKET_CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# 5. FRONTEND CLIENT & CORS ORIGINS
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# 6. EMAIL & SMTP SERVICE (For Registration OTP & Password Reset)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_EMAIL="your-official-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"

# 7. HTTP COOKIE SECURITY POLICIES (false for HTTP dev, true for HTTPS prod)
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
COOKIE_HTTP_ONLY=true
COOKIE_DOMAIN=""
COOKIE_MAX_AGE=7776000000

# 8. CLOUDINARY MEDIA CLOUD STORAGE (Images, Reels, Videos & Stories)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="vybe-uploads"

# 9. GOOGLE OAUTH 2.0 SINGLE SIGN-ON (SSO)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CLIENT_IDS=""

# 10. RAZORPAY MONETIZATION & CREATOR SUBSCRIPTIONS
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# 11. WEBRTC AUDIO/VIDEO CALLING & LIVE STREAMING (STUN/TURN)
TURN_SECRET="vybe_coturn_secret_pass_2026"
TURN_SERVER_DOMAIN="turn.vybe.app"
STUN_SERVER_URL="stun:stun.l.google.com:19302"

# 12. ARTIFICIAL INTELLIGENCE (Groq Llama-3.3, Gemini & OpenAI)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY=""

# 13. FILE UPLOADS & SERVER LIMITS (1GB Max for 4K & VYBE TV)
MAX_FILE_SIZE=1073741824
UPLOAD_DIR="./uploads"

# 14. LOGGING & SYSTEM TELEMETRY
LOG_LEVEL="debug"
