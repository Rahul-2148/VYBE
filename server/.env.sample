# Environment
NODE_ENV=development

# Server Configuration
PORT=8000
HOST=localhost

# Database
MONGODB_URI="your-mongodb-connection-string"

# JWT
JWT_SECRET="your-jwt-secret"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"

# Client / CORS
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
SOCKET_CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Socket.IO
SOCKET_HOST="http://localhost:8000"
SOCKET_TRANSPORTS="websocket,polling"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_EMAIL="your-email@example.com"
SMTP_PASSWORD="your-app-password"

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
COOKIE_HTTP_ONLY=true
COOKIE_DOMAIN=""
COOKIE_MAX_AGE=7776000000

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="vybe-uploads"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CLIENT_IDS="client-id-1,client-id-2"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_S1Vs1ViGRVLSlE"
RAZORPAY_KEY_SECRET="A2yFN4pvGLbVGdL6aOXLF4mX"

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=debug
