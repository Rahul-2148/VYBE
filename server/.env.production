# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================

# Environment
NODE_ENV=production

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database (Use MongoDB Atlas for production)
MONGODB_URL=your-production-mongodb-url
MONGODB_URI=your-production-mongodb-url

# JWT Configuration
JWT_SECRET=your-production-jwt-secret-keep-this-safe
REFRESH_TOKEN_SECRET=your-production-refresh-token-secret-keep-this-safe

# Client URLs (for CORS)
CLIENT_URL=https://vybe.com
FRONTEND_URL=https://vybe.com
CORS_ORIGINS=https://vybe.com,https://www.vybe.com
SOCKET_CORS_ORIGINS=https://vybe.com,https://www.vybe.com

# Socket.IO Configuration
SOCKET_HOST=https://api.vybe.com
SOCKET_TRANSPORTS=websocket

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your-production-email@example.com
SMTP_PASSWORD=your-production-app-password

# Cookie Configuration (Secure for production)
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_HTTP_ONLY=true
COOKIE_DOMAIN=.vybe.com
COOKIE_MAX_AGE=7776000000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-production-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-production-cloudinary-api-key
CLOUDINARY_API_SECRET=your-production-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=vybe-uploads

# Google OAuth
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_CLIENT_IDS=your-production-google-client-id

# Razorpay
RAZORPAY_KEY_ID=your-production-razorpay-key-id
RAZORPAY_KEY_SECRET=your-production-razorpay-key-secret

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=/var/uploads

# Logging
LOG_LEVEL=info
